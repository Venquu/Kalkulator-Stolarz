<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<title>Wycena dla stolarza</title>

<style>

body{
    font-family: Arial;
    background:#f2f2f2;
    margin:20px;
}

.box{
    background:white;
    padding:15px;
    border:1px solid #ccc;
}

.logo{
    background:#222;
    color:white;
    padding:10px;
    width:70px;
    text-align:center;
    font-weight:bold;
}

.top{
    display:flex;
    gap:20px;
    align-items:center;
    border-bottom:1px dotted #777;
    padding-bottom:10px;
}

.blue{
    color:#28758a;
    font-size:12px;
}

.dane{
    display:flex;
    gap:15px;
    margin-top:15px;
}

.dane div{
    flex:1;
}

input, select{
    width:100%;
    height:25px;
    border:1px solid #bbb;
    background:#eef8fb;
    box-sizing:border-box;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:15px;
    font-size:12px;
}

th,td{
    border:1px solid #ccc;
    padding:5px;
    text-align:center;
}

th{
    background:#e8eeee;
}

button{
    margin-top:10px;
    padding:8px 12px;
    border:0;
    background:#28758a;
    color:white;
    cursor:pointer;
}

button:hover{
    background:#1d5c6c;
}

.podsumowanie{
    width:350px;
    margin-left:auto;
    margin-top:20px;
    border:1px solid #ccc;
}

.podsumowanie div{
    padding:8px;
    border-bottom:1px solid #ddd;
    display:flex;
    justify-content:space-between;
}

.suma{
    background:#28758a;
    color:white;
    font-size:18px;
    font-weight:bold;
}

</style>
</head>

<body>

<div class="box">

    <div class="top">

        <div class="logo">
            TWOJE<br>LOGO
        </div>

        <div class="blue">
            <b>TWOJA FIRMA</b><br>
            ul. Solarna 18<br>
            Warszawa
        </div>

        <div class="blue">
            www.twojafirma.pl<br>
            biuro@twojafirma.pl
        </div>

    </div>


    <div class="dane">

        <div>
            <b>DANE OFERTY</b><br>

            Numer oferty:
            <input value="112/2024">

            Data:
            <input type="date">
        </div>


        <div>
            <b>ZAMAWIAJĄCY</b><br>

            Imię i nazwisko:
            <input placeholder="Imię i nazwisko">

            Adres:
            <input placeholder="Adres">
        </div>


        <div>
            <b>MONTAŻ</b><br>

            Adres:
            <input placeholder="Adres">

            Data montażu:
            <input type="date">
        </div>

    </div>


    <p class="blue">
        <b>WYCENA DLA:</b>

        <select style="width:130px">
            <option>KUCHNIA</option>
            <option>ŁAZIENKA</option>
            <option>SALON</option>
            <option>GARDEROBA</option>
        </select>
    </p>


    <table id="tabela">

        <tr>
            <th>SZAFKA</th>
            <th>KORPUS</th>
            <th>FRONT</th>
            <th>SZER. (cm)</th>
            <th>WYS. (cm)</th>
            <th>GŁĘB. (cm)</th>
            <th>ILOŚĆ</th>
            <th>CENA</th>
            <th>RAZEM</th>
            <th></th>
        </tr>


        <tr>

            <td>
                <input value="Szafka 1">
            </td>

            <td>
                <select class="korpus">
                    <option value="sosna">Sosna</option>
                    <option value="dab">Dąb</option>
                    <option value="biala">Biała płyta</option>
                </select>
            </td>

            <td>
                <select class="front">
                    <option value="dab">Dąb Riviera</option>
                    <option value="bialy">Biały</option>
                    <option value="czarny">Czarny</option>
                </select>
            </td>

            <td>
                <input class="szer" type="number" value="60">
            </td>

            <td>
                <input class="wys" type="number" value="72">
            </td>

            <td>
                <input class="gleb" type="number" value="56">
            </td>

            <td>
                <input class="ilosc" type="number" value="1">
            </td>

            <td>
                <input class="cena" type="number" value="0" readonly>
            </td>

            <td class="razem">
                0,00 zł
            </td>

            <td>
                <button onclick="usun(this)">X</button>
            </td>

        </tr>

    </table>


    <button onclick="dodaj()">
        + DODAJ SZAFKĘ
    </button>


    <div class="podsumowanie">

        <div>
            <span>Meble:</span>
            <b id="meble">0,00 zł</b>
        </div>

        <div>
            <span>Transport:</span>

            <input
                id="transport"
                type="number"
                value="0"
                style="width:100px"
                onchange="licz()"
            >
        </div>

        <div>
            <span>Montaż:</span>

            <input
                id="montaz"
                type="number"
                value="0"
                style="width:100px"
                onchange="licz()"
            >
        </div>

        <div>
            <span>Rabat %:</span>

            <input
                id="rabat"
                type="number"
                value="0"
                style="width:100px"
                onchange="licz()"
            >
        </div>

        <div>
            <span>Netto:</span>
            <b id="netto">0,00 zł</b>
        </div>

        <div>
            <span>VAT 23%:</span>
            <b id="vat">0,00 zł</b>
        </div>

        <div class="suma">
            <span>DO ZAPŁATY:</span>
            <span id="brutto">0,00 zł</span>
        </div>

    </div>


    <br>

    <b>UWAGI:</b>

    <br>

    <textarea
        style="width:100%;height:70px;margin-top:5px"
        placeholder="Tutaj wpisz dodatkowe informacje..."
    ></textarea>


</div>


<script>



var cenyKorpusu = {

    sosna: 120,
    dab: 250,
    biala: 100

};


var cenyFrontu = {

    dab: 300,
    bialy: 220,
    czarny: 250

};


var robocizna = 250;



function cenaSzafki(wiersz){

    var szer =
        Number(wiersz.querySelector(".szer").value) || 0;

    var wys =
        Number(wiersz.querySelector(".wys").value) || 0;

    var gleb =
        Number(wiersz.querySelector(".gleb").value) || 0;

    var ilosc =
        Number(wiersz.querySelector(".ilosc").value) || 0;


    var korpus =
        wiersz.querySelector(".korpus").value;

    var front =
        wiersz.querySelector(".front").value;



    var powierzchniaKorpusu =

        (
            (2 * wys * gleb) +
            (2 * szer * gleb)
        ) / 10000;



    var powierzchniaFrontu =
        (szer * wys) / 10000;


    var cenaKorpusu =
        powierzchniaKorpusu *
        cenyKorpusu[korpus];


    var cenaFrontu =
        powierzchniaFrontu *
        cenyFrontu[front];


    var cenaJednejSzafki =

        cenaKorpusu +
        cenaFrontu +
        robocizna;


    var cenaRazem =
        cenaJednejSzafki * ilosc;


    return cenaRazem;
}



function licz(){

    var suma = 0;

    var wiersze =
        document.querySelectorAll("#tabela tr");


    for(var i = 1; i < wiersze.length; i++){

        var wiersz = wiersze[i];


        if(
            wiersz.querySelector(".cena") &&
            wiersz.querySelector(".ilosc")
        ){

            var cena =
                cenaSzafki(wiersz);


            

            var ilosc =
                Number(
                    wiersz.querySelector(".ilosc").value
                ) || 0;


            var cenaJednej =
                ilosc > 0
                ? cena / ilosc
                : 0;


            

            wiersz.querySelector(".cena").value =
                cenaJednej.toFixed(2);


         

            wiersz.querySelector(".razem").innerHTML =
                cena.toFixed(2) + " zł";


            suma += cena;

        }

    }


    var transport =
        Number(
            document.getElementById("transport").value
        ) || 0;


    var montaz =
        Number(
            document.getElementById("montaz").value
        ) || 0;


    var rabat =
        Number(
            document.getElementById("rabat").value
        ) || 0;


    var razem =
        suma +
        transport +
        montaz;


    var znizka =
        razem * rabat / 100;


    var netto =
        razem - znizka;


    var vat =
        netto * 0.23;


    var brutto =
        netto + vat;


    document.getElementById("meble").innerHTML =
        suma.toFixed(2) + " zł";


    document.getElementById("netto").innerHTML =
        netto.toFixed(2) + " zł";


    document.getElementById("vat").innerHTML =
        vat.toFixed(2) + " zł";


    document.getElementById("brutto").innerHTML =
        brutto.toFixed(2) + " zł";

}

function dodaj(){

    var tabela =
        document.getElementById("tabela");


    var wiersz =
        tabela.insertRow(-1);


    wiersz.innerHTML = `

        <td>
            <input value="Nowa szafka">
        </td>

        <td>
            <select class="korpus">
                <option value="sosna">Sosna</option>
                <option value="dab">Dąb</option>
                <option value="biala">Biała płyta</option>
            </select>
        </td>

        <td>
            <select class="front">
                <option value="dab">Dąb Riviera</option>
                <option value="bialy">Biały</option>
                <option value="czarny">Czarny</option>
            </select>
        </td>

        <td>
            <input
                class="szer"
                type="number"
                value="60"
            >
        </td>

        <td>
            <input
                class="wys"
                type="number"
                value="72"
            >
        </td>

        <td>
            <input
                class="gleb"
                type="number"
                value="56"
            >
        </td>

        <td>
            <input
                class="ilosc"
                type="number"
                value="1"
            >
        </td>

        <td>
            <input
                class="cena"
                type="number"
                value="0"
                readonly
            >
        </td>

        <td class="razem">
            0,00 zł
        </td>

        <td>
            <button onclick="usun(this)">X</button>
        </td>

    `;


    licz();

}


function usun(przycisk){

    var wiersz =
        przycisk.parentNode.parentNode;


    wiersz.remove();


    licz();

}



document.addEventListener("input", function(){

    licz();

});


document.addEventListener("change", function(){

    licz();

});


licz();

</script>

</body>
</html>
